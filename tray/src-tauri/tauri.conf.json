{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sbee",
  "version": "0.1.0",
  "identifier": "com.siaflex.sbee",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sbee",
        "width": 390,
        "height": 580,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Sbee — Veeam ortamı izleme",
    "longDescription": "Siaflex Sbee: Veeam yedekleme ortamınızın durumunu sistem tepsisinden anlık takip edin.",
    "publisher": "Siaflex"
  }
}
