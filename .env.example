# --- Siaflex Sbee Intelligence ayarları ---
# Bu dosyayı .env olarak kopyalayın (install.sh otomatik yapar) ve chmod 600 verin.

# Dış port (varsayılan 8080)
#SBEE_PORT=8080

# İlk Veeam sunucusunu önceden tanımlamak İSTEĞE BAĞLIDIR.
# Boş bırakılırsa kurulumdan sonra arayüzdeki ⚙ Ayarlar > Sunucu Ekle'den eklenir.
#PRODUCT_NAME=vbr
#WEB_URL=https://veeam-sunucu-adresi/
#ADMIN_USERNAME=kullanici
#ADMIN_PASSWORD=parola
#ACCEPT_SELF_SIGNED_CERT=true
#SERVER_NAME=Merkez VBR

# Arayüz kişiselleştirme (isteğe bağlı)
#UI_TITLE=Siaflex Sbee Intelligence
#UI_WELCOME=Merhaba, ben Sbee! ...
#UI_SUGGESTIONS=["Örnek soru 1","Örnek soru 2"]
#QUOTA_LIMIT=200
#ASK_TIMEOUT_MS=240000

# Farklı bir MCP server kullanılıyorsa (imaj build'inde MCP_REPO da değiştirilmeli)
#MCP_TOOL_NAME=
#MCP_QUESTION_ARG=
